{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "olefoot-revela",
  "compatibility_date": "2026-04-13",
  // O Worker existe só pra injetar as meta tags de compartilhamento por rota
  // (ver worker.ts). Sem ele, todo link do REVELA mostraria o mesmo preview.
  "main": "./worker.ts",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.25
  },
  "assets": {
    "directory": "./dist",
    // O binding faz o Worker servir os arquivos; o SPA fallback continua valendo
    // pras rotas de cliente (/t/..., /lenda/...).
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // ⚠️ SEM ISTO O WORKER NÃO RODA NA HOME.
    // Por padrão, quando existe um arquivo pro caminho pedido, o Cloudflare o
    // serve direto e nem invoca o Worker. Como `/` casa com o index.html, a home
    // saía sem as tags injetadas.
    // Agora roda em `/*` por causa do LINK CURTO revela.olefoot.com/<handle>: o
    // crawler pede o handle solto, e sem o Worker o preview seria o da home. O
    // Worker devolve asset não-HTML intocado (guard de content-type em worker.ts),
    // então o custo é um hop a mais por request — o preço do link curto com preview.
    "run_worker_first": ["/*"]
  },
  "vars": {
    // Preenchidos no deploy a partir do .env da raiz (ver npm run deploy:revela).
    // A anon key já é pública — ela viaja no bundle do front. Não é segredo.
    "SUPABASE_URL": "",
    "SUPABASE_ANON_KEY": ""
  }
  // Domínio: apontar revela.olefoot.com para este Worker no painel Cloudflare
  // (Workers & Pages → olefoot-revela → Settings → Domains & Routes).
}
