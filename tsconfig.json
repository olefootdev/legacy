{
  // Só o app Vite principal (./src).
  //
  // ⚠️ Este comentário já MENTIU: dizia que `npm run lint` fazia server e
  // mobile também, e não fazia — o script só rodava este arquivo. Resultado:
  // código de servidor que não compila passou por "lint ok" aqui e só quebrou
  // no build do Railway, em produção, com o deploy falhando calado enquanto eu
  // procurava o motivo do 404.
  //
  // Agora `npm run lint` roda, nesta ordem: este + server + mobile +
  // tsconfig.carteira.json (strict, só a carteira) + dex. Se acrescentar um
  // projeto novo, acrescente no script — comentário não roda.
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/vite-env.d.ts", "vite.config.ts"],
  "exclude": ["node_modules", "dist", "web", "server", "mobile", "src/**/*.test.ts"]
}
